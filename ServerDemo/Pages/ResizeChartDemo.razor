@page "/resize-chart-demo"

<PageTitle>Resize Chart</PageTitle>
<h1>Resize Chart</h1>

<p>This page demonstrates a chart that resizes to fit its parent container. Drag the bottom-right corner of the container to resize it.</p>

<div id="demo">
    <div id="chart-container"
         style="width: @(_containerWidth)px; height: @(_containerHeight)px; resize: both; overflow: hidden; border: 1px solid gray;">
        <SciChartSurface Style="width: 100%; height: 100%">
            <XAxes>
                <NumericAxis VisibleRange="@(new NumberRange { Min = 0, Max = 10 })" />
            </XAxes>
            <YAxes>
                <NumericAxis VisibleRange="@(new NumberRange { Min = -1.5, Max = 1.5 })" />
            </YAxes>
            <FastLineRenderableSeries Id="line1" Stroke="#4CAF50" StrokeThickness="3" SeriesName="Sine Wave">
                <XyDataSeries XValues="@xData" YValues="@yData" />
            </FastLineRenderableSeries>
            <MouseWheelZoomModifier />
            <ZoomPanModifier />
        </SciChartSurface>
    </div>
</div>
<button id="btn-resize-container" type="button" class="btn btn-secondary mt-2" @onclick="ResizeContainer">
    Resize Container
</button>
<button id="btn-reset-container" type="button" class="btn btn-secondary mt-2" @onclick="ResetContainer">
    Reset Container
</button>
