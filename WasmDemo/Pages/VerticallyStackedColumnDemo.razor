@page "/vertically-stacked-column-demo"
@rendermode InteractiveWebAssembly

<PageTitle>Vertically Stacked Column Chart</PageTitle>

<h1>Vertically Stacked Column Chart</h1>

<p>This example demonstrates vertically stacked columns where series stack on top of each other. Two stacked groups share one collection, each bound to its own Y axis.</p>

<div style="display: flex">
    <div id="demo" style="width: 600px;">
        <SciChartSurface @ref="_sciChartRef" HeightAspect="2" WidthAspect="3">
            <XAxes>
                <NumericAxis Id="xAxis" AxisTitle="Category" VisibleRange="@(new NumberRange { Min = -1, Max = 8 })" />
            </XAxes>
            <YAxes>
                <NumericAxis Id="yAxis" AxisTitle="Group A" AxisAlignment="EAxisAlignment.Left" GrowBy="@(new NumberRange { Min = 0, Max = 0.1 })" />
                <NumericAxis Id="yAxis2" AxisTitle="Group B" AxisAlignment="EAxisAlignment.Right" GrowBy="@(new NumberRange { Min = 0, Max = 0.1 })" />
            </YAxes>

            <StackedColumnCollection IsOneHundredPercent="@_isOneHundredPercent" XAxisId="xAxis" YAxisId="yAxis" DataPointWidth="0.5">
                <StackedColumnRenderableSeries
                    Id="series1"
                    StackedGroupId="GroupA"
                    Fill="rgba(70, 130, 180, 0.8)"
                    Stroke="#4682B4"
                    StrokeThickness="1"
                    SeriesName="Product A">
                    <XyDataSeries @ref="_xyDataSeriesSeries1Ref" XValues="@_xData" YValues="@_yData1" />
                </StackedColumnRenderableSeries>

                <StackedColumnRenderableSeries
                    Id="series2"
                    StackedGroupId="GroupA"
                    Fill="rgba(255, 140, 0, 0.8)"
                    Stroke="#FF8C00"
                    StrokeThickness="1"
                    SeriesName="Product B">
                    <XyDataSeries @ref="_xyDataSeriesSeries2Ref" XValues="@_xData" YValues="@_yData2" />
                </StackedColumnRenderableSeries>

                <StackedColumnRenderableSeries
                    Id="series3"
                    StackedGroupId="GroupA"
                    Fill="rgba(50, 205, 50, 0.8)"
                    Stroke="#32CD32"
                    StrokeThickness="1"
                    SeriesName="Product C">
                    <XyDataSeries @ref="_xyDataSeriesSeries3Ref" XValues="@_xData" YValues="@_yData3" />
                </StackedColumnRenderableSeries>

                <StackedColumnRenderableSeries
                    Id="series4"
                    StackedGroupId="GroupB"
                    YAxisId="yAxis2"
                    Fill="rgba(133, 98, 180, 0.8)"
                    Stroke="#8562B4"
                    StrokeThickness="1"
                    SeriesName="Product D">
                    <XyDataSeries @ref="_xyDataSeriesSeries4Ref" XValues="@_xData" YValues="@_yData4" />
                </StackedColumnRenderableSeries>

                <StackedColumnRenderableSeries
                    Id="series5"
                    StackedGroupId="GroupB"
                    YAxisId="yAxis2"
                    Fill="rgba(220, 68, 63, 0.8)"
                    Stroke="#DC443F"
                    StrokeThickness="1"
                    SeriesName="Product E">
                    <XyDataSeries @ref="_xyDataSeriesSeries5Ref" XValues="@_xData" YValues="@_yData5" />
                </StackedColumnRenderableSeries>
            </StackedColumnCollection>

            <MouseWheelZoomModifier />
            <ZoomPanModifier />
        </SciChartSurface>
    </div>
    <div>
        <button id="btn-append-data" type="button" class="btn btn-secondary mt-2 ms-2" @onclick="AppendData">
            Append Data
        </button>
        <br />
        <button type="button" class="btn btn-secondary mt-2 ms-2" @onclick="AppendDataByPointer">
            Append Data By Pointer
        </button>
    </div>
</div>

<div style="margin-top: 20px;">
    <label>
        <input type="checkbox" @bind="_isOneHundredPercent" @bind:after="OnStackingModeChanged" />
        Use 100% Stacking Mode
    </label>
</div>
